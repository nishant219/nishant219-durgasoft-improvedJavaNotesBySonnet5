</table>
<table>
<tr><th>#</th><th>Method</th><th>Purpose</th></tr>
<tr><td>1</td><td>add(E e)</td><td>Add single element</td></tr>
<tr><td>2</td><td>addAll(Collection c)</td><td>Add all elements from another collection</td></tr>
