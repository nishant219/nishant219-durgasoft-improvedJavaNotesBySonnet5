</table>
<table>
<tr><th>#</th><th>Property</th><th>ArrayList behavior</th></tr>
<tr><td>1</td><td>Underlying data structure</td><td>Resizable (growable) array</td></tr>
<tr><td>2</td><td>Duplicates</td><td>Allowed</td></tr>
<tr><td>3</td><td>Insertion order</td><td>Preserved</td></tr>
<tr><td>4</td><td>Heterogeneous objects</td><td>Allowed</td></tr>
<tr><td>5</td><td>Null insertion</td><td>Possible</td></tr>
</table>
<table>
<tr><th>Event</th><th>Current capacity</th><th>Calculation</th><th>New capacity</th></tr>
<tr><td>Initial create</td><td>—</td><td>default</td><td>10</td></tr>
<tr><td>11th element added</td><td>10</td><td>(10 × 3/2) + 1 = 15 + 1</td><td>16</td></tr>
<tr><td>17th element added</td><td>16</td><td>(16 × 3/2) + 1 = 24 + 1</td><td>25</td></tr>
<tr><td>26th element added</td><td>25</td><td>(25 × 3/2) + 1 = 37 + 1</td><td>38</td></tr>
</table>
<table>
<tr><th>#</th><th>Constructor</th><th>Creates</th></tr>
<tr><td>1</td><td>ArrayList()</td><td>Empty ArrayList, default initial capacity 10</td></tr>
