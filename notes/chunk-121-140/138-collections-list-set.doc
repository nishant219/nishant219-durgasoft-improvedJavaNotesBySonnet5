</table>
<table>
<tr><th>Method</th><th>Returns</th><th>Description</th></tr>
<tr><td>void add(int index, E e)</td><td>void</td><td>Insert at index; shifts right</td></tr>
<tr><td>boolean addAll(int index, Collection&lt;? extends E&gt; c)</td><td>boolean</td><td>Insert all from c at index</td></tr>
<tr><td>E remove(int index)</td><td>E</td><td>Remove and return element at index</td></tr>
<tr><td>E get(int index)</td><td>E</td><td>Return element at index</td></tr>
<tr><td>E set(int index, E e)</td><td>E</td><td>Replace element at index</td></tr>
<tr><td>int indexOf(Object o)</td><td>int</td><td>First occurrence index (-1 if absent)</td></tr>
<tr><td>int lastIndexOf(Object o)</td><td>int</td><td>Last occurrence index (-1 if absent)</td></tr>
