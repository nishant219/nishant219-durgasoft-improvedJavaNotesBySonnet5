<tr><td>boolean contains(Object o)</td><td>boolean</td><td>Checks if element present</td></tr>
<tr><td>boolean containsAll(Collection&lt;?&gt; c)</td><td>boolean</td><td>Checks if all of c present</td></tr>
<tr><td>boolean isEmpty()</td><td>boolean</td><td>true if size == 0</td></tr>
