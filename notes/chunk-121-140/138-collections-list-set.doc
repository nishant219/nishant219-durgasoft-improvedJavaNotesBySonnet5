<tr><td>Map</td><td>Curly braces { } with key=value</td><td>{1=Durga, 2=Ravi, 3=Shiva}</td></tr>
</table>
<table>
<tr><th>Method</th><th>Returns</th><th>Description</th></tr>
<tr><td>boolean add(E e)</td><td>boolean</td><td>Adds single element</td></tr>
