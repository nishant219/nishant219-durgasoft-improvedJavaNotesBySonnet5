<tr><td>7</td><td>Duplicate values</td><td>✓</td><td>✓</td></tr>
<tr><td>8</td><td>Null key</td><td>✓ (one null key allowed)</td><td>✗ (Java 7+; see null rules)</td></tr>
<tr><td>9</td><td>Null value</td><td>✓</td><td>✓</td></tr>
<tr><td>10</td><td>Heterogeneous keys</td><td>✓</td><td>✗ — ClassCastException</td></tr>
