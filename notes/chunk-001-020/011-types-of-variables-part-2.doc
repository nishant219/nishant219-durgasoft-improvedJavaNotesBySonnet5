<table>
<tr><th>Name</th><th>Why</th></tr>
<tr><td>local variables</td><td>declared inside method / block / constructor</td></tr>
<tr><td>temporary variables</td><td>not permanent data; only while that block runs</td></tr>
<tr><td>stack variables</td><td>stored in stack memory</td></tr>
<tr><td>automatic variables</td><td>available inside the block, automatically gone outside</td></tr>
</table>
<table>
<tr><th>Code</th><th>Result</th></tr>
<tr><td>int x; System.out.println(&quot;hello&quot;);</td><td>compiles; prints hello</td></tr>
<tr><td>int x; System.out.println(x);</td><td>CE: variable x might not have been initialized</td></tr>
</table>
<table>
<tr><th>Command</th><th>Meaning</th><th>Output</th></tr>
<tr><td>java Test a</td><td>passing a command-line argument</td><td>10</td></tr>
<tr><td>java Test</td><td>no command-line argument</td><td>20</td></tr>
<tr><td>java Test a b</td><td>still args.length &gt; 0</td><td>10</td></tr>
</table>
<table>
<tr><th>Modifier</th><th>Access (preview of access modifiers)</th></tr>
<tr><td>public</td><td>anywhere</td></tr>
<tr><td>private</td><td>only within the class</td></tr>
<tr><td>default (no modifier)</td><td>anywhere in the current package</td></tr>
<tr><td>protected</td><td>current package anywhere; outside package only in child classes</td></tr>
</table>
<table>
<tr><th>Type of variable</th><th>Thread-safe?</th></tr>
<tr><td>instance variable</td><td>no</td></tr>
<tr><td>static variable</td><td>no</td></tr>
<tr><td>local variable</td><td>yes</td></tr>
</table>
<table>
<tr><th>Variable</th><th>instance / static / local</th><th>primitive / reference</th><th>Combination</th></tr>
<tr><td>x</td><td>instance</td><td>primitive (int)</td><td>instance primitive</td></tr>
<tr><td>s</td><td>static</td><td>reference (String object)</td><td>static reference</td></tr>
<tr><td>y</td><td>local</td><td>reference (array is an object)</td><td>local reference</td></tr>
</table>
<table>
<tr><th>Declaration</th><th>System.out.println(x)</th><th>System.out.println(x[0])</th></tr>
<tr><td>instance int[] x;</td><td>null</td><td>NullPointerException</td></tr>
<tr><td>instance int[] x = new int[3];</td><td>[I@&lt;hashcode&gt;</td><td>0</td></tr>
<tr><td>static int[] x;</td><td>null</td><td>NullPointerException</td></tr>
<tr><td>static int[] x = new int[3];</td><td>[I@&lt;hashcode&gt;</td><td>0</td></tr>
<tr><td>local int[] x;</td><td>CE: variable x might not have been initialized</td><td>CE: same</td></tr>
<tr><td>local int[] x = new int[3];</td><td>[I@&lt;hashcode&gt;</td><td>0</td></tr>
</table>
