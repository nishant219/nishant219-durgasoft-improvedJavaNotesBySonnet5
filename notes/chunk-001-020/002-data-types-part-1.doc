<tr><td>byte b = 10.5;</td><td>invalid</td><td>possible loss of precision — found: double, required: byte</td></tr>
<tr><td>byte b = true;</td><td>invalid</td><td>incompatible types — found: boolean, required: byte</td></tr>
<tr><td>byte b = &quot;durga&quot;;</td><td>invalid</td><td>incompatible types — found: java.lang.String, required: byte</td></tr>
</table>
<table>
<tr><th></th><th></th></tr>
<tr><td>Size</td><td>2 bytes (16 bits)</td></tr>
<tr><td>Range (formula)</td><td>−2¹⁵ to 2¹⁵ − 1</td></tr>
<tr><td>Range (numbers)</td><td>−32,768 to 32,767</td></tr>
</table>
<table>
<tr><th>Code</th><th>Valid?</th><th>Error</th></tr>
<tr><td>short s = 32767;</td><td>valid</td><td>max short</td></tr>
<tr><td>short s = 32768;</td><td>invalid</td><td>possible loss of precision — found int, required short</td></tr>
<tr><td>short s = 10.5;</td><td>invalid</td><td>possible loss of precision — found double, required short</td></tr>
<tr><td>short s = true;</td><td>invalid</td><td>incompatible types — found boolean, required short</td></tr>
</table>
<table>
<tr><th></th><th></th></tr>
<tr><td>Size</td><td>4 bytes (32 bits)</td></tr>
<tr><td>Range (formula)</td><td>−2³¹ to 2³¹ − 1</td></tr>
<tr><td>Range (numbers)</td><td>−2,147,483,648 to 2,147,483,647</td></tr>
</table>
<table>
<tr><th>Code</th><th>Error</th></tr>
<tr><td>int x = 2147483647;</td><td>none (valid)</td></tr>
<tr><td>int x = 2147483648;</td><td>integer number too large</td></tr>
<tr><td>int x = 2147483648L;</td><td>possible loss of precision, found long, required int</td></tr>
<tr><td>int x = true;</td><td>incompatible types, found boolean, required int</td></tr>
</table>
