<tr><td>7</td><td>IllegalArgumentException</td><td>Started (detailed in 079)</td></tr>
<tr><td>8</td><td>NumberFormatException</td><td>Video 079</td></tr>
<tr><td>9</td><td>IllegalStateException</td><td>Video 079</td></tr>
<tr><td>10</td><td>AssertionError</td><td>Video 079</td></tr>
</table>
