        //     IOException
        //       EOFException
        //       FileNotFoundException
        //       InterruptedIOException
        //     InterruptedException
        //     ServletException
        //     RemoteException
        //   Error
        //     VirtualMachineError
        //       StackOverflowError
        //       OutOfMemoryError
        //     ExceptionInInitializerError
