        try
            System.out.println(&quot;try&quot;);
        catch (Exception e)
            System.out.println(&quot;catch&quot;);
        finally
            System.out.println(&quot;finally&quot;);
        // CE: &#x27;{&#x27; expected  (try)
        // CE: &#x27;{&#x27; expected  (catch)
