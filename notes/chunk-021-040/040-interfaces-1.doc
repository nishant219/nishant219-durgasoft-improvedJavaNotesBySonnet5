<table>
<tr><th>Expression</th><th>What X / Y / Z must be</th></tr>
<tr><td>X extends Y</td><td>Both classes, or both interfaces</td></tr>
<tr><td>X extends Y, Z</td><td>All interfaces</td></tr>
<tr><td>X implements Y, Z</td><td>X class; Y, Z interfaces</td></tr>
<tr><td>X extends Y implements Z</td><td>X, Y classes; Z interface</td></tr>
<tr><td>X implements Y extends Z</td><td>Always CE — wrong keyword order</td></tr>
</table>
</body></html>
